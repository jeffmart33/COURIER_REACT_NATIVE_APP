{
  "expo": {
    "name": "Hooks Delivery Partner",
    "slug": "HooksFoodApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "hooksfoodapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hooksfood.courier",
      "config": {
        "googleMapsApiKey": "AIzaSyB__ZRbKICdDaJl4IM4MwFofeYIZdDLJKQ"
      },
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "location"
        ],
        "NSLocationWhenInUseUsageDescription": "Hooks uses your location to offer you nearby deliveries and show customers where their order is.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Hooks uses your location while you are online or on a delivery, even when the app is closed, to offer you nearby deliveries and show customers where their order is."
      }
    },
    "android": {
      "package": "com.hooksfood.courier",
      "versionCode": 16,
      "icon": "./assets/images/icon.png",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB__ZRbKICdDaJl4IM4MwFofeYIZdDLJKQ"
        }
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#f97316"
        }
      ],
      "expo-video",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/new_order.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "isIosBackgroundLocationEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Hooks uses your location while you are online or on a delivery, even when the app is closed, to offer you nearby deliveries and show customers where their order is."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c69ad056-b11a-44ca-b4de-626f54c21980"
      }
    },
    "owner": "jeffery655"
  }
}
